# ArangoDB Connection Configuration
# 
# Docker ArangoDB (default - recommended for development):
# The Docker ArangoDB instance runs on port 8529 (default ArangoDB port).
ARANGO_HOST=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=kessler_dev_password
#
# Remote ArangoDB:
# For connecting to a remote ArangoDB instance:
# ARANGO_HOST=http://remote-host:8529
# ARANGO_USER=your_username
# ARANGO_PASSWORD=your_password

# CORS Configuration
# Comma-separated list of allowed origins
# Development default: http://localhost:3000
# Production: Add your domain(s)
CORS_ORIGINS=http://localhost:3000

# Authentication
# Username for the app login (default: admin)
APP_USERNAME=admin
# Password for the app login (required; app will warn on startup if unset)
APP_PASSWORD=changeme

# Shantanu's API login credentials
SHANTANU_USERNAME=shantanu
SHANTANU_PASSWORD=changeme

# Ashutosh's API login credentials
ASHUTOSH_USERNAME=ashutosh
ASHUTOSH_PASSWORD=changeme

# SpaceTrack Credentials (https://www.space-track.org)
# Used as a fallback TLE data source for debris objects not found on CelesTrak.
# Register for a free account at https://www.space-track.org/auth/createAccount
# Both naming conventions are accepted (SPACETRACK_USERNAME or SPACE_TRACK_USER):
SPACETRACK_USERNAME=your_email@example.com
SPACETRACK_PASSWORD=your_password
# SPACE_TRACK_USER=your_email@example.com   # legacy alias, also accepted
# SPACE_TRACK_PASS=your_password            # legacy alias, also accepted

# LangGraph Agent Configuration
# Required for the /v2/ask endpoint.
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# LLM model to use (default: gpt-4o-mini)
AGENT_MODEL=gpt-4o-mini

# ChromaDB vector store path for RAG index (default: .chroma)
AGENT_VECTOR_STORE_PATH=.chroma
