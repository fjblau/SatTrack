%----------------------------------------
% GMAT Kestrel Maneuver Plan Script
% Auto-generated by gmat_maneuver_service.py
% Force model: EGM96 8x8, RK89 integrator
%----------------------------------------

%--- Kestrel spacecraft ---
Create Spacecraft Kestrel;
Kestrel.DateFormat          = UTCGregorian;
Kestrel.Epoch               = '%KESTREL_EPOCH%';
Kestrel.CoordinateSystem    = EarthMJ2000Eq;
Kestrel.DisplayStateType    = Keplerian;
Kestrel.SMA                 = %KESTREL_SMA%;
Kestrel.ECC                 = %KESTREL_ECC%;
Kestrel.INC                 = %KESTREL_INC%;
Kestrel.RAAN                = %KESTREL_RAAN%;
Kestrel.AOP                 = %KESTREL_AOP%;
Kestrel.TA                  = %KESTREL_TA%;
Kestrel.DryMass             = 500;
Kestrel.Cd                  = 2.2;
Kestrel.Cr                  = 1.8;
Kestrel.DragArea            = 10;
Kestrel.SRPArea             = 10;

%--- Target spacecraft ---
Create Spacecraft Target;
Target.DateFormat           = UTCGregorian;
Target.Epoch                = '%TARGET_EPOCH%';
Target.CoordinateSystem     = EarthMJ2000Eq;
Target.DisplayStateType     = Keplerian;
Target.SMA                  = %TARGET_SMA%;
Target.ECC                  = %TARGET_ECC%;
Target.INC                  = %TARGET_INC%;
Target.RAAN                 = %TARGET_RAAN%;
Target.AOP                  = %TARGET_AOP%;
Target.TA                   = %TARGET_TA%;
Target.DryMass              = 1000;
Target.Cd                   = 2.2;
Target.Cr                   = 1.8;
Target.DragArea             = 20;
Target.SRPArea              = 20;

%--- Force model: EGM96 8x8 gravity ---
Create ForceModel ManeuverFM;
ManeuverFM.CentralBody                  = Earth;
ManeuverFM.PrimaryBodies                = {Earth};
ManeuverFM.GravityField.Earth.Degree    = 8;
ManeuverFM.GravityField.Earth.Order     = 8;
ManeuverFM.GravityField.Earth.PotentialFile = 'EGM96.cof';
ManeuverFM.ErrorControl                 = RSSStep;

%--- Propagator ---
Create Propagator ManeuverProp;
ManeuverProp.FM                 = ManeuverFM;
ManeuverProp.Type               = RungeKutta89;
ManeuverProp.InitialStepSize    = 60;
ManeuverProp.Accuracy           = 1e-12;
ManeuverProp.MinStep            = 0.001;
ManeuverProp.MaxStep            = 300;
ManeuverProp.MaxStepAttempts    = 50;

%--- Departure burn (prograde/retrograde depending on sign of DV1) ---
Create ImpulsiveBurn Burn1;
Burn1.CoordinateSystem  = VNB;
Burn1.Element1          = %DV1_KM_S%;
Burn1.Element2          = 0;
Burn1.Element3          = 0;

%--- Arrival circularization burn ---
Create ImpulsiveBurn Burn2;
Burn2.CoordinateSystem  = VNB;
Burn2.Element1          = %DV2_KM_S%;
Burn2.Element2          = 0;
Burn2.Element3          = 0;

%--- Report: positions of both spacecraft at each step ---
Create ReportFile ManeuverReport;
ManeuverReport.Filename     = '%OUTPUT_FILE%';
ManeuverReport.Add          = {Kestrel.UTCGregorian, Kestrel.X, Kestrel.Y, Kestrel.Z, Target.X, Target.Y, Target.Z};
ManeuverReport.WriteHeaders = true;
ManeuverReport.ColumnWidth  = 25;
ManeuverReport.Precision    = 10;
ManeuverReport.WriteReport  = true;

%--- Mission Sequence ---
BeginMissionSequence;

%  Phase 1: Park and wait for phase alignment
Propagate ManeuverProp(Kestrel, Target) {Kestrel.ElapsedSecs = %WAIT_SECS%};

%  Burn 1: Departure (raises/lowers apogee to transfer altitude)
Maneuver Burn1(Kestrel);

%  Phase 2: Transfer arc coast
Propagate ManeuverProp(Kestrel, Target) {Kestrel.ElapsedSecs = %TRANSFER_SECS%};

%  Burn 2: Arrival circularization
Maneuver Burn2(Kestrel);

%  Phase 3: Short proximity window — capture closest approach
Propagate ManeuverProp(Kestrel, Target) {Kestrel.ElapsedSecs = 600};
